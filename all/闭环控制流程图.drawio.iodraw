<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.4.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram id="closed-loop-control" name="闭环控制流程图">
    <mxGraphModel dx="2398" dy="1428" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图7  三级级联视觉伺服闭环控制流程图" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="10" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="start" value="视觉伺服启动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" parent="1" vertex="1">
