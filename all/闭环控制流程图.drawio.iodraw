          <mxGeometry x="640" y="240" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="进入中心可信区？&#xa;|ex| ≤ 180 px 且 conf ≥ 0.30" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="620" y="380" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="第一级 方位引导 J1&#xa;死区 + 步长限幅 ±0.10 rad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="570" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="第二级 深度趋近 pid_z&#xa;Kp=1.0，Ki=0.15，Kd=0.05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="400" y="570" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="第三级 俯仰锁定 pid_cy&#xa;Kp=0.9，Ki=0.08，Kd=0.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="780" y="570" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="位置式PID + 速度连续化映射&#xa;u(k) = Kp·e(k) + Ki·Σ e(j)·ΔT + Kd·(e(k) − e(k−1))/ΔT&#xa;积分限幅 · 零交叉清零 · 动态死区&#xa;v = sat(Δθ)/T_measure（T=0.25 s，子步长 20 ms）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="750" width="1060" height="150" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="逆运动学 → 关节伺服（J1/J2/J3/J4）→ 机械臂 / 相机光轴&#xa;目标保持画面中心" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
